# Everything under results/ is generated by code/run.
/results/*
!/results/.gitkeep

# Input data is NOT tracked. It ships with the Code Ocean capsule and is
# staged by hand for a local run -- see data/README.md for the manifest and
# code/check_inputs.R to verify a directory. Keeping patient-derived matrices
# out of git history is what lets this repository be mirrored publicly.
/data/**
!/data/README.md
!/data/**/
!/data/**/README.md
!/data/**/README

.Rhistory
.RData
.Rproj.user/
*.Rproj
.DS_Store
**/.DS_Store
*_cache/
*_files/
