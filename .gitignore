# Everything under results/ is generated by code/run.
/results/*
!/results/.gitkeep

# Processed, de-identified study data are tracked (slides and ROIs recoded;
# see data/README.md). The raw TCGA files are third-party data and are never
# redistributed: users fetch them with code/fetch_tcga.sh. Only the processed
# score table data/data_tcga/TCGA_COADREAD_aHSC_GSVA_PFS.csv is tracked.
/data/data_tcga/data_clinical_patient.txt
/data/data_tcga/data_mrna_seq_v2_rsem_zscores_ref_all_samples.txt

.Rhistory
.RData
.Rproj.user/
*.Rproj
.DS_Store
**/.DS_Store
*_cache/
*_files/
